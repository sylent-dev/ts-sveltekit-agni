{
	"name": "agni",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "eslint . --max-warnings 0 && stylelint \"**/*.{css,svelte}\" --max-warnings 0",
		"test:unit": "vitest --run",
		"test:e2e": "playwright test",
		"check": "npm run format:check && npm run check:types && npm run lint && npm run test:unit && npm run build && npm run test:e2e",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@libsql/client": "^0.18.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.1.0",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"postcss-html": "^2.0.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"stylelint": "^18.1.0",
		"stylelint-config-html": "^2.0.0",
		"stylelint-config-standard": "^41.1.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"allowScripts": {
		"esbuild": false
	}
}
